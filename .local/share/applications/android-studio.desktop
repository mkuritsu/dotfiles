[Desktop Entry]
Version=1.0
Type=Application
Name=Android Studio
Exec=android-studio -Dawt.toolkit.name=WLToolkit %f
Icon=android-studio
Comment=The official Android IDE
Categories=Development;IDE;
Terminal=false
StartupNotify=true
StartupWMClass=jetbrains-studio
MimeType=application/x-extension-iml;
