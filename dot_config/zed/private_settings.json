// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "edit_predictions": {
    "ollama": {
      "model": "hf.co/bartowski/zed-industries_zeta-2-GGUF:latest",
      "prompt_format": "zeta2",
      "max_output_tokens": 10000,
    },
    "open_ai_compatible_api": {
      "api_url": "",
    },
    "mode": "subtle",
    "provider": "zed",
  },
  "use_podman": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "redact_private_values": true,
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "model": "opencode/deepseek-v4-flash-free",
      },
      "type": "registry",
    },
  },
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "helix_mode": false,
  "vim_mode": true,
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "colorize_brackets": true,
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Macchiato - No Italics",
  },
  "buffer_font_features": {
    "calt": false,
  },
  "lsp": {
    // "rust-analyzer": {
    //   "initialization_options": {
    //     "checkOnSave": true,
    //     "check": {
    //       "command": "clippy",
    //     },
    //   },
    // },
  },
  "languages": {
    "Nix": {
      "formatter": {
        "external": {
          "command": "alejandra",
          "arguments": ["-"],
        },
      },
    },
  },
}
