autoload -U compinit; compinit
autoload zmv
autoload -Uz edit-command-line
zle -N edit-command-line

export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=100000
export SAVEHIST=100000
export SHELL=zsh
export PATH="$HOME/.local/bin:${PATH}"
export PATH="$HOME/.cargo/bin:${PATH}"

# pnpm
export PNPM_HOME="/home/kuritsu/.local/share/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

cd_fzf() {
    dir=$(find ~/ ~/Dev . -mindepth 1 -maxdepth 1 \( -type d -o -type l \) | fzf)
    if [ -n "${dir}" ]; then
        cd $dir
        zle reset-prompt
    fi
}
zle -N cd_fzf

chpwd() {
    if [[ -d .venv ]]; then
        source .venv/bin/activate
    elif [[ -n "$VIRTUAL_ENV" ]]; then
        deactivate
    fi
}

bindkey '^F' cd_fzf
bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word
bindkey "^[[1;3C" forward-word
bindkey "^[[1;3D" backward-word
bindkey "^[[H" beginning-of-line
bindkey "^[[F" end-of-line
bindkey "^[[3~" delete-char
bindkey "^H" backward-kill-word
bindkey "^z" undo
bindkey "^r" redo
bindkey "^e" edit-command-line

alias ls='ls --color=auto'
alias ip='ip --color=auto'
alias grep='grep --color=auto'
alias wget="wget --hsts-file=/dev/null"

eval "$(starship init zsh)"

typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='default'
ZSH_HIGHLIGHT_STYLES[alias]='default'
ZSH_HIGHLIGHT_STYLES[builtin]='default'
ZSH_HIGHLIGHT_STYLES[function]='fg=yellow'
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
