{
  "diff_view_style": "split",
  "format_on_save": "on",
  "vim_mode": false,
  "helix_mode": false,
  "base_keymap": "VSCode",
  "ui_font_size": 15,
  "colorize_brackets": true,
  "cli_default_open_behavior": "new_window",
  "redact_private_values": true,
  "buffer_font_size": 13.0,
  "buffer_font_features": {
    "calt": false,
  },
  "minimap": {
    "show": "auto",
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "project_panel": {
    "dock": "left",
  },
}
