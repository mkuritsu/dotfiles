{
  "minimap": {
    "show": "auto",
  },
  "diff_view_style": "split",
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "format_on_save": "on",
  "project_panel": {
    "dock": "left",
  },
  "vim_mode": true,
  "helix_mode": false,
  "base_keymap": "VSCode",
  "ui_font_size": 15,
  "buffer_font_size": 13,
  "buffer_font_features": {
    "calt": false,
  },
  "colorize_brackets": true,
  "cli_default_open_behavior": "new_window",
  "redact_private_values": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "disable_ai": true,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "VSCode 2026 Dark",
  },
}
