[
  {
    "bindings": {
      "ctrl-(": "workspace::ToggleHelixMode",
    },
  },
  {
    "bindings": {
      "ctrl-)": "workspace::ToggleVimMode",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "s": "vim::HelixJumpToWord",
    },
  },
]
