[core]
	editor = "nvim"

[init]
	defaultBranch = "main"

[pull]
	rebase = true

[user]
	email = "me@mkuritsu.dev"
	name = "mkuritsu"
	signingkey = ~/.ssh/id_ed25519.pub

[commit]
	gpgSign = true

[gpg]
	format = ssh

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
